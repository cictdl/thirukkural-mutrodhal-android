<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light parent in light mode (values-night has the dark one) so web content such as the
         bundled privacy policy follows the phone's theme. -->
    <style name="Theme.Tirukkural" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
